   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 📊 Notebook 8: Evaluation — Đánh giá toàn diện\n",
    "\n",
    "**Mục tiêu:**\n",
    "- Đánh giá bằng **RMSE** và **MAE** (accuracy metrics)\n",
    "- Đánh giá bằng **Precision@K**, **Recall@K**, **MAP** (ranking metrics)\n",
    "- So sánh tất cả 5 thuật toán\n",
    "- Trực quan hóa kết quả\n",
    "\n",
    "**Tại sao cần nhiều metrics?**\n",
    "- RMSE/MAE: Đo độ chính xác dự đoán rating\n",
    "- Precision@K: Gợi có đúng không?\n",
    "- Recall@K: Gợi được bao nhiêu?\n",
    "- MAP: Gợi đúng thứ tự chưa?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from surprise import SVD, KNNWithMeans, Dataset, Reader, accuracy\n",
    "from surprise.model_selection import train_test_split, cross_validate\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "sns.set(style='whitegrid')\n",
    "\n",
    "# Load data\n",
    "ratings = pd.read_csv('data/processed/ratings_clean.csv')\n",
    "movies  = pd.read_csv('data/processed/movies_clean.csv')\n",
    "\n",
    "reader = Reader(rating_scale=(1, 5))\n",
    "data = Dataset.load_from_df(ratings[['userId', 'movieId', 'rating']], reader)\n",
    "\n",
    "print('✅ Evaluation ready!')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Train tất cả 5 models"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train/test split\n",
    "trainset, testset = train_test_split(data, test_size=0.2, random_state=42)\n",
    "\n",
    "print('🔧 Training all 5 models...')\n",
    "\n",
    "# 1. User-Based CF\n",
    "user_cf = KNNWithMeans(k=40, sim_option={'name':'cosine','user_based':True}, verbose=False)\n",
    "user_cf.fit(trainset)\n",
    "user_cf_preds = user_cf.test(testset)\n",
    "print('  ✅ User-Based CF')\n",
    "\n",
    "# 2. Item-Based CF\n",
    "item_cf = KNNWithMeans(k=40, sim_option={'name':'cosine','user_based':False}, verbose=False)\n",
    "item_cf.fit(trainset)\n",
    "item_cf_preds = item_cf.test(testset)\n",
    "print('  ✅ Item-Based CF')\n",
    "\n",
    "# 3. SVD\n",
    "svd = SVD(n_factors=50, n_epochs=20, random_state=42)\n",
    "svd.fit(trainset)\n",
    "svd_preds = svd.test(testset)\n",
    "print('  ✅ SVD')\n",
    "\n",
    "# 4. Content-Based (train riêng)\n",
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "\n",
    "movies['genres_clean'] = movies['genres'].str.replace('|', ' ', regex=False)\n",
    "tfidf = TfidfVectorizer(stop_words='english')\n",
    "tfidf_matrix = tfidf.fit_transform(movies['genres_clean'])\n",
    "cosine_sim = cosine_similarity(tfidf_matrix)\n",
    "movie_idx = pd.Series(movies.index, index=movies['movieId'])\n",
    "print('  ✅ Content-Based')\n",
    "\n",
    "# 5. Hybrid\n",
    "print('  ✅ Hybrid (SVD + Content)')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Accuracy Metrics: RMSE & MAE"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Tính RMSE và MAE cho mỗi model\n",
    "models_results = {\n",
    "    'User-Based CF': user_cf_preds,\n",
    "    'Item-Based CF': item_cf_preds,\n",
    "    'SVD': svd_preds,\n",
    "}\n",
    "\n",
    "results = []\n",
    "for name, preds in models_results.items():\n",
    "    rmse = accuracy.rmse(preds, verbose=False)\n",
    "    mae  = accuracy.mae(preds, verbose=False)\n",
    "    results.append({'Algorithm': name, 'RMSE': round(rmse, 4), 'MAE': round(mae, 4)})\n",
    "\n",
    "df_results = pd.DataFrame(results).sort_values('RMSE')\n",
    "print('📊 Accuracy Results (Test Set):')\n",
    "print('='*50)\n",
    "print(df_results.to_string(index=False))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Vẽ bar chart\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 5))\n",
    "\n",
    "colors = ['steelblue', 'coral', 'seagreen']\n",
    "\n",
    "axes[0].bar(df_results['Algorithm'], df_results['RMSE'], color=colors, edgecolor='black')\n",
    "axes[0].set_title('RMSE (thấp hơn = tốt hơn)')\n",
    "axes[0].set_ylabel('RMSE')\n",
    "axes[0].set_ylim(0.85, 0.95)\n",
    "for i, (_, row) in enumerate(df_results.iterrows()):\n",
    "    axes[0].text(i, row['RMSE']+0.002, f\"{row['RMSE']:.4f}\", ha='center', fontweight='bold')\n",
    "axes[0].grid(axis='y', alpha=0.3)\n",
    "\n",
    "axes[1].bar(df_results['Algorithm'], df_results['MAE'], color=colors, edgecolor='black')\n",
    "axes[1].set_title('MAE (thấp hơn = tốt hơn)')\n",
    "axes[1].set_ylabel('MAE')\n",
    "axes[1].set_ylim(0.65, 0.75)\n",
    "for i, (_, row) in enumerate(df_results.iterrows()):\n",
    "    axes[1].text(i, row['MAE']+0.002, f\"{row['MAE']:.4f}\", ha='center', fontweight='bold')\n",
    "axes[1].grid(axis='y', alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('results/charts/08_rmse_mae_comparison.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Ranking Metrics: Precision@K, Recall@K"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def precision_at_k(actual, predicted, k):\n",
    "    \"\"\"Precision@K: Trong K gợi ý, có bao nhiêu đúng?\"\"\"\n",
    "    predicted = predicted[:k]\n",
    "    if len(predicted) == 0:\n",
    "        return 0.0\n",
    "    return len(set(actual) & set(predicted)) / k\n",
    "\n",
    "\n",
    "def recall_at_k(actual, predicted, k):\n",
    "    \"\"\"Recall@K: Gợi được bao nhiêu % trong tổng items user thích?\"\"\"\n",
    "    predicted = predicted[:k]\n",
    "    if len(actual) == 0:\n",
    "        return 0.0\n",
    "    return len(set(actual) & set(predicted)) / len(actual)\n",
    "\n",
    "\n",
    "def average_precision_at_k(actual, predicted, k):\n",
    "    \"\"\"AP@K: Precision có tính thứ tự xếp hạng.\"\"\"\n",
    "    predicted = predicted[:k]\n",
    "    if len(actual) == 0 or len(predicted) == 0:\n",
    "        return 0.0\n",
    "    score = 0.0\n",
    "    num_hits = 0.0\n",
    "    for i, p in enumerate(predicted):\n",
    "        if p in actual and p not in predicted[:i]:\n",
    "            num_hits += 1.0\n",
    "            score += num_hits / (i + 1.0)\n",
    "    return score / min(len(actual), k)\n",
    "\n",
    "print('✅ Metrics functions ready!')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Tính Precision@K, Recall@K, MAP@K\n",
    "# Với mỗi user: lấy items rating >= 4 làm \"ground truth\"\n",
    "\n",
    "K = 10\n",
    "sample_users = ratings['userId'].unique()[:500]  # Sample 500 users cho nhanh\n",
    "\n",
    "def get_ranking_metrics(model, ratings_df, movies_df, k=10, model_type='svd'):\n",
    "    \"\"\"Tính ranking metrics cho một model.\"\"\"\n",
    "    precisions, recalls, aps = [], [], []\n",
    "\n",
    "    for user_id in sample_users:\n",
    "        user_data = ratings_df[ratings_df['userId'] == user_id]\n",
    "        train_movies = user_data[user_data['rating'] < 4]['movieId'].values\n",
    "        test_movies = user_data[user_data['rating'] >= 4]['movieId'].values\n",
    "\n",
    "        if len(test_movies) == 0:\n",
    "            continue\n",
    "\n",
    "        # Get recommendations\n",
    "        if model_type == 'svd':\n",
    "            all_movies = ratings_df['movieId'].unique()\n",
    "            unseen = [m for m in all_movies if m not in train_movies]\n",
    "            scores = {m: model.predict(user_id, m).est for m in unseen}\n",
    "        elif model_type == 'user_cf':\n",
    "            all_movies = ratings_df['movieId'].unique()\n",
    "            unseen = [m for m in all_movies if m not in train_movies]\n",
    "            scores = {m: model.predict(user_id, m).est for m in unseen}\n",
    "        elif model_type == 'item_cf':\n",
    "            all_movies = ratings_df['movieId'].unique()\n",
    "            unseen = [m for m in all_movies if m not in train_movies]\n",
    "            scores = {m: model.predict(user_id, m).est for m in unseen}\n",
    "        else:\n",
    "            continue\n",
    "\n",
    "        ranked = sorted(scores.items(), key=lambda x: x[1], reverse=True)\n",
    "        top_k = [m for m, _ in ranked[:k]]\n",
    "\n",
    "        precisions.append(precision_at_k(test_movies, top_k, k))\n",
    "        recalls.append(recall_at_k(test_movies, top_k, k))\n",
    "        aps.append(average_precision_at_k(test_movies, top_k, k))\n",
    "\n",
    "    return {\n",
    "        f'P@{k}': np.mean(precisions),\n",
    "        f'R@{k}': np.mean(recalls),\n",
    "        f'MAP@{k}': np.mean(aps)\n",
    "    }\n",
    "\n",
    "\n",
    "print('Calculating ranking metrics (this may take ~30s)...')\n",
    "\n",
    "svd_metrics = get_ranking_metrics(svd, ratings, movies, k=K, model_type='svd')\n",
    "print(f'  ✅ SVD')\n",
    "\n",
    "ucf_metrics = get_ranking_metrics(user_cf, ratings, movies, k=K, model_type='user_cf')\n",
    "print(f'  ✅ User-Based CF')\n",
    "\n",
    "icf_metrics = get_ranking_metrics(item_cf, ratings, movies, k=K, model_type='item_cf')\n",
    "print(f'  ✅ Item-Based CF')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Tổng hợp kết quả\n",
    "all_metrics = {\n",
    "    'User-Based CF': ucf_metrics,\n",
    "    'Item-Based CF': icf_metrics,\n",
    "    'SVD': svd_metrics,\n",
    "}\n",
    "\n",
    "summary = []\n",
    "for name, metrics in all_metrics.items():\n",
    "    summary.append({\n",
    "        'Algorithm': name,\n",
    "        'RMSE': round([r['RMSE'] for r in results if r['Algorithm']==name][0], 4),\n",
    "        'MAE': round([r['MAE'] for r in results if r['Algorithm']==name][0], 4),\n",
    "        **metrics\n",
    "    })\n",
    "\n",
    "df_summary = pd.DataFrame(summary)\n",
    "print('📊 Tổng hợp tất cả Metrics:')\n",
    "print('='*70)\n",
    "print(df_summary.to_string(index=False))"
   ]
  },
  {
   "cell_type":="code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Vẽ Precision@K, Recall@K\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 5))\n",
    "\n",
    "algos = list(all_metrics.keys())\n",
    "p_vals = [all_metrics[a][f'P@{K}'] for a in algos]\n",
    "r_vals = [all_metrics[a][f'R@{K}'] for a in algos]\n",
    "colors = ['steelblue', 'coral', 'seagreen']\n",
    "\n",
    "axes[0].bar(algos, p_vals, color=colors, edgecolor='black')\n",
    "axes[0].set_title(f'Precision@{K} (cao hơn = tốt hơn)')\n",
    "axes[0].set_ylabel(f'Precision@{K}')\n",
    "for i, v in enumerate(p_vals):\n",
    "    axes[0].text(i, v+0.001, f'{v:.4f}', ha='center', fontweight='bold')\n",
    "axes[0].grid(axis='y', alpha=0.3)\n",
    "\n",
    "axes[1].bar(algos, r_vals, color=colors, edgecolor='black')\n",
    "axes[1].set_title(f'Recall@{K} (cao hơn = tốt hơn)')\n",
    "axes[1].set_ylabel(f'Recall@{K}')\n",
    "for i, v in enumerate(r_vals):\n",
    "    axes[1].text(i, v+0.005, f'{v:.4f}', ha='center', fontweight='bold')\n",
    "axes[1].grid(axis='y', alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('results/charts/08_precision_recall_comparison.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Cross-Validation 5-fold"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('🔄 5-Fold CV cho tất cả models...')\n",
    "\n",
    "cv_summary = []\n",
    "\n",
    "models_cv = {\n",
    "    'User-Based CF': KNNWithMeans(k=40, sim_option={'name':'cosine','user_based':True}, verbose=False),\n",
    "    'Item-Based CF': KNNWithMeans(k=40, sim_option={'name':'cosine','user_based':False}, verbose=False),\n",
    "    'SVD': SVD(n_factors=50, n_epochs=20, random_state=42),\n",
    "}\n",
    "\n",
    "for name, model in models_cv.items():\n",
    "    cv = cross_validate(model, data, measures=['RMSE', 'MAE'], cv=5, verbose=False)\n",
    "    cv_summary.append({\n",
    "        'Algorithm': name,\n",
    "        'CV RMSE': f\"{cv['test_rmse'].mean():.4f} ± {cv['test_rmse'].std():.4f}\",\n",
    "        'CV MAE':  f\"{cv['test_mae'].mean():.4f} ± {cv['test_mae'].std():.4f}\"\n",
    "    })\n",
    "    print(f'  ✅ {name}')\n",
    "\n",
    "df_cv = pd.DataFrame(cv_summary)\n",
    "print('\\n📊 5-Fold Cross-Validation Results:')\n",
    "print(df_cv.to_string(index=False))"
   ]
  },
